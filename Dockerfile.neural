# Optional Python/ONNX CPU extraction helper, NOT the standalone Rust solver.
# Build context is generated by tools/neural_parser/stage.ps1.
ARG SOLVER_IMAGE=veridyct:evidence-rust
FROM ${SOLVER_IMAGE} AS solver

FROM python:3.11-slim@sha256:6d85378d88a19cd4d76079817532d62232be95757cb45945a99fec8e8084b9c2 AS neural-parser
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
WORKDIR /opt/veridyct-extractor
COPY requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt
COPY batch.py provenance.json __init__.py ./
COPY frozen/ ./frozen/
COPY model/ ./model/
RUN python3 -c "from batch import verify_artifacts; verify_artifacts('model')"
USER 10001
ENTRYPOINT ["python3", "/opt/veridyct-extractor/batch.py"]

# Opt-in hybrid runtime. The solver image is built separately with Dockerfile.
# Build with --target hybrid --build-arg SOLVER_IMAGE=veridyct:evidence-rust.
FROM neural-parser AS hybrid
WORKDIR /app
COPY --from=solver /app/veridyct /app/veridyct
COPY --from=solver /app/veridyct-api /app/veridyct-api
ENV HOME=/tmp XDG_CACHE_HOME=/tmp VERIDYCT_ADDR=0.0.0.0:8787 VERIDYCT_NEURAL_HELPER=/opt/veridyct-extractor/batch.py
EXPOSE 8787
USER 10001
ENTRYPOINT ["/app/veridyct"]
CMD ["run"]
