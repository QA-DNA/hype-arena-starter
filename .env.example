# Featherless AI API Credentials
# Sign up at https://featherless.ai, go to Keys/Settings, copy your API key, and paste below:
FEATHERLESS_API_KEY=your_featherless_api_key_here

# Default model on Featherless (OpenAI-compatible)
# Recommended fast models for high-throughput synthetic text generation:
# - meta-llama/Meta-Llama-3.1-8B-Instruct
# - mistralai/Mistral-7B-Instruct-v0.3
# - Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
